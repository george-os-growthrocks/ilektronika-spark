# Card checkout. Prefer a restricted key (rk_) from a Stripe sandbox.
# If this is empty, Buy now opens the offer form instead of Checkout.
STRIPE_SECRET_KEY=

# Signing secret for /api/stripe/webhook. Required before a payment is treated
# as complete. The ?paid=1 page is only a thank-you screen.
STRIPE_WEBHOOK_SECRET=

# Optional. If both are set, the offer form emails anotherseoguru@mail.grokbot.com
# (CONTACT_EMAIL in src/config/site.ts) via Resend. Otherwise the form opens a
# mailto: link to that inbox.
RESEND_API_KEY=
OFFER_FROM_EMAIL=
